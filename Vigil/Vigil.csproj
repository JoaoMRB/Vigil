<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Vigil</AssemblyName>
    <RootNamespace>Vigil</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- The installer (installer/Vigil.iss) reads this version. -->
    <Version>0.1.0</Version>
    <Product>Vigil</Product>
    <Company>Vigil</Company>
    <Description>Vigil: your PC on a USB desk display</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The app sits in the tray all day: favour a small footprint over throughput. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- The texts drawn on the screen, one file per language. -->
    <EmbeddedResource Include="i18n\*.json" LogicalName="i18n.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings window: a page shown in WebView2, with its fonts in Ui\fonts. -->
    <Content Include="Ui\**\*" Exclude="Ui\fonts\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
